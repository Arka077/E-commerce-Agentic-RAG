profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version if you're
#   using pyenv and micro-managing it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used with a verified Pipfile, it is also recommended.
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is database of dependencies and should be checked in.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is database of dependencies and should be checked in.
#   pdm.lock

# PEP 582; used by e.g. pdm when initialized with `pdm init venv`
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

